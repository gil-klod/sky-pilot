{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sim/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/arcade", "destination": "/arcade/index.html" },
    { "source": "/sim", "destination": "/sim/index.html" },
    { "source": "/sim/v2", "destination": "/sim/v2/index.html" },
    { "source": "/sim/fly", "destination": "/sim/fly/index.html" },
    { "source": "/sim/fly-v2", "destination": "/sim/fly-v2/index.html" }
  ]
}
